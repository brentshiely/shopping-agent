{
  "manifest_version": 3,
  "name": "ShoppingAgent",
  "version": "0.1.15",
  "description": "Your AI shopping agent that finds the best deals across grocery stores",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webRequest",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://target.com/*",
    "https://www.target.com/*",
    "https://walmart.com/*",
    "https://www.walmart.com/*",
    "https://amazon.com/*",
    "https://www.amazon.com/*",
    "https://kroger.com/*",
    "https://www.kroger.com/*",
    "https://instacart.com/*",
    "https://www.instacart.com/*",
    "https://publix.com/*",
    "https://www.publix.com/*",
    "https://albertsons.com/*",
    "https://www.albertsons.com/*",
    "https://ralphs.com/*",
    "https://fredmeyer.com/*",
    "https://qfc.com/*",
    "https://citymarket.com/*",
    "https://kingsoopers.com/*",
    "https://smithsfoodanddrug.com/*",
    "https://safeway.com/*",
    "https://vons.com/*",
    "https://jewelosco.com/*",
    "https://shaws.com/*",
    "https://starmarket.com/*",
    "https://foodlion.com/*",
    "https://stopandshop.com/*",
    "https://giantfood.com/*",
    "https://harristeeter.com/*",
    "https://samsclub.com/*",
    "https://wholefoodsmarket.com/*",
    "https://amazonfresh.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://target.com/*",
        "https://www.target.com/*"
      ],
      "js": [
        "content-scripts/target.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://walmart.com/*",
        "https://www.walmart.com/*"
      ],
      "js": [
        "content-scripts/walmart.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://amazon.com/*",
        "https://www.amazon.com/*"
      ],
      "js": [
        "content-scripts/amazon.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://kroger.com/*",
        "https://www.kroger.com/*",
        "https://ralphs.com/*",
        "https://fredmeyer.com/*",
        "https://qfc.com/*",
        "https://citymarket.com/*",
        "https://kingsoopers.com/*",
        "https://smithsfoodanddrug.com/*"
      ],
      "js": [
        "content-scripts/kroger.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://instacart.com/*",
        "https://www.instacart.com/*"
      ],
      "js": [
        "content-scripts/instacart.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://wholefoodsmarket.com/*",
        "https://www.wholefoodsmarket.com/*",
        "https://amazonfresh.com/*"
      ],
      "js": [
        "content-scripts/whole-foods.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://costco.com/*",
        "https://www.costco.com/*"
      ],
      "js": [
        "content-scripts/costco.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ShoppingAgent Deals"
  },
  "side_panel": {
    "default_path": "side_panel.html"
  }
}
